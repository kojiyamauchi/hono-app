{
  "name": "hono-cloudflare-compatibility",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "verify": "bun verify.mjs",
    "verify:database": "bun verify.mjs --database",
    "measure:cpu": "bun measureCpu.mjs",
    "prepare:remote": "bun prepareRemote.mjs",
    "configure:access": "bun configureAccess.mjs",
    "deploy:remote": "bun prepareRemote.mjs && wrangler deploy --config .wrangler/wrangler.remote.json --secrets-file .wrangler/secrets.remote.json"
  },
  "devDependencies": {
    "argon2-browser": "1.18.0",
    "argon2id": "1.0.1",
    "hash-wasm": "4.12.0",
    "wrangler": "4.163.0"
  }
}
