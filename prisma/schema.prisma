generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int                      @id @default(autoincrement())
  name                    String
  email                   String                   @unique
  password                String
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             Membership[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id          Int          @id @default(autoincrement())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  invitations Invitation[]
  auditLogs   AuditLog[]
}

model Membership {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  // 組織単位のメンバー一覧取得（参加日時順）と、組織削除時の一括削除を支援する。
  // カーソル式ページネーションの行値比較（("createdAt", id) > (...)）の境界条件をIndex Condへ入れるため、idまで含める。
  // 2カラム構成ではFilterとIncremental Sortが残るため、末尾にidを足した形へ置き換えている（旧indexはprefixで冗長）。
  @@index([organizationId, createdAt, id])
}

enum AuditAction {
  MEMBER_ROLE_CHANGED
  OWNERSHIP_TRANSFERRED
  MEMBER_REMOVED
}

model AuditLog {
  id                 Int          @id @default(autoincrement())
  organizationId     Int
  action             AuditAction
  // 操作者・対象のIDは記録時点の値として保存する。ユーザーやメンバーシップが削除された後も
  // 記録を残すため、UserとMembershipへの外部キーは設定しない。
  actorUserId        Int
  targetUserId       Int
  targetMembershipId Int
  previousRole       Role
  newRole            Role
  createdAt          DateTime     @default(now())
  // 組織が削除されたときは、同じトランザクション内で記録も削除する。
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // 組織単位の監査ログ一覧取得（新しい順）を支援する。
  // カーソル式ページネーションの行値比較（("createdAt", id) < (...)）の境界条件をIndex Condへ入れるため、idまで含める。
  // 並びはDESCだが、btreeの逆方向スキャンで満たせるためindexはASCのまま定義する。
  @@index([organizationId, createdAt, id])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELED
  DECLINED
}

model Invitation {
  id             Int              @id @default(autoincrement())
  organizationId Int
  email          String
  role           Role
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
