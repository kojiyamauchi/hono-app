# このファイルを.env.cloudflare.localへコピーし、実値はコピー先だけへ記入する。
# Terraform用。Wrangler OAuthとは別に対象アカウント限定のAPIトークンを作成する。
CLOUDFLARE_API_TOKEN=

# Cloudflare Accessの自動検証用サービストークン。APIトークンとは別物。
CLOUDFLARE_SPIKE_ACCESS_CLIENT_ID=
CLOUDFLARE_SPIKE_ACCESS_CLIENT_SECRET=

# 通常は空欄。prepare:remoteが生成し、配備時にSecretへ登録する。
CLOUDFLARE_SPIKE_TOKEN=

# Access保護後に有効化した検証WorkerのHTTPS Origin。
CLOUDFLARE_SPIKE_URL=
