{
  "name": "hono-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prepare": "husky",
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint --fix --max-warnings 0",
    "lint:check": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "spellcheck": "cspell --dot --no-must-find-files '**/*'",
    "test": "bun test --isolate",
    "test:container": "bash scripts/verify-container.sh",
    "lint-staged": "lint-staged --allow-empty",
    "typecheck": "tsc --noEmit",
    "db:start": "bunx supabase@2.101.0 start",
    "db:stop": "bunx supabase@2.101.0 stop",
    "db:reset": "bunx supabase@2.101.0 db reset",
    "db:status": "bunx supabase@2.101.0 status",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate:dev": "bunx prisma migrate dev",
    "prisma:migrate:deploy": "bunx --bun prisma migrate deploy",
    "prisma:validate": "bunx prisma validate",
    "prisma:format": "bunx prisma format",
    "prisma:studio": "bunx prisma studio",
    "tf:aws:init": "terraform -chdir=infra/aws init",
    "tf:aws:init:no-backend": "terraform -chdir=infra/aws init -backend=false",
    "tf:aws:account:init:no-backend": "terraform -chdir=infra/aws/account init -backend=false",
    "tf:aws:account:validate": "terraform -chdir=infra/aws/account validate",
    "tf:aws:workspace:dev": "terraform -chdir=infra/aws workspace select -or-create dev",
    "tf:aws:plan": "terraform -chdir=infra/aws plan",
    "tf:aws:apply": "terraform -chdir=infra/aws apply",
    "tf:fmt": "terraform -chdir=infra fmt -recursive",
    "tf:fmt:check": "terraform -chdir=infra fmt -recursive -check -diff",
    "tf:aws:lint:init": "tflint --chdir=infra/aws --init",
    "tf:aws:lint": "tflint --chdir=infra/aws",
    "tf:aws:validate": "terraform -chdir=infra/aws validate",
    "tf:aws:test:vpc:init": "terraform -chdir=infra/aws/modules/vpc init -backend=false -plugin-dir=../../.terraform/providers && terraform -chdir=infra/aws/modules/vpc/security_group init -backend=false -plugin-dir=../../../.terraform/providers",
    "tf:aws:test:ecs:init": "terraform -chdir=infra/aws/modules/ecs init -backend=false -plugin-dir=../../.terraform/providers && terraform -chdir=infra/aws/modules/ecs/iam/roles init -backend=false -plugin-dir=../../../../.terraform/providers && terraform -chdir=infra/aws/modules/ecs/task init -backend=false -plugin-dir=../../../.terraform/providers && terraform -chdir=infra/aws/modules/ecs/service init -backend=false -plugin-dir=../../../.terraform/providers && terraform -chdir=infra/aws/modules/ecs/service/alb init -backend=false -plugin-dir=../../../../.terraform/providers",
    "tf:aws:test:ecr:init": "terraform -chdir=infra/aws/modules/ecr init -backend=false -plugin-dir=../../.terraform/providers",
    "tf:aws:test:iam:init": "terraform -chdir=infra/aws/modules/iam/provider/oidc/github init -backend=false",
    "tf:aws:test:logs:init": "terraform -chdir=infra/aws/modules/cloudwatch/logs init -backend=false -plugin-dir=../../../.terraform/providers",
    "tf:aws:test:init": "bun run tf:aws:test:vpc:init && bun run tf:aws:test:ecs:init && bun run tf:aws:test:ecr:init && bun run tf:aws:test:iam:init && bun run tf:aws:test:logs:init",
    "tf:aws:test:vpc": "terraform -chdir=infra/aws/modules/vpc test && terraform -chdir=infra/aws/modules/vpc/security_group test",
    "tf:aws:test:ecs": "terraform -chdir=infra/aws/modules/ecs test && terraform -chdir=infra/aws/modules/ecs/iam/roles test && terraform -chdir=infra/aws/modules/ecs/task test && terraform -chdir=infra/aws/modules/ecs/service test && terraform -chdir=infra/aws/modules/ecs/service/alb test",
    "tf:aws:test:ecr": "terraform -chdir=infra/aws/modules/ecr test",
    "tf:aws:test:iam": "terraform -chdir=infra/aws/modules/iam/provider/oidc/github test",
    "tf:aws:test:logs": "terraform -chdir=infra/aws/modules/cloudwatch/logs test",
    "tf:aws:test:root": "terraform -chdir=infra/aws test",
    "tf:aws:test": "bun run tf:aws:test:vpc && bun run tf:aws:test:ecs && bun run tf:aws:test:ecr && bun run tf:aws:test:iam && bun run tf:aws:test:logs && bun run tf:aws:test:root",
    "tf:gcp:init": "terraform -chdir=infra/gcp init -backend-config=env/backend.local.hcl",
    "tf:gcp:init:no-backend": "terraform -chdir=infra/gcp init -backend=false",
    "tf:gcp:workspace:dev": "terraform -chdir=infra/gcp workspace select -or-create dev",
    "tf:gcp:plan": "terraform -chdir=infra/gcp plan",
    "tf:gcp:apply": "terraform -chdir=infra/gcp apply",
    "tf:gcp:lint:init": "tflint --chdir=infra/gcp --init",
    "tf:gcp:lint": "tflint --chdir=infra/gcp",
    "tf:gcp:validate": "terraform -chdir=infra/gcp validate",
    "tf:gcp:test": "terraform -chdir=infra/gcp test"
  },
  "dependencies": {
    "@hono/otel": "1.1.2",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.8.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.8.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-pg": "^0.71.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/hono-api-reference": "^0.11.8",
    "@supabase/supabase-js": "^2.107.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "pg": "^8.21.0",
    "resend": "^6.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/parser": "^8.41.0",
    "cspell": "^9.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.41.0"
  }
}
