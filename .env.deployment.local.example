# .env.deployment.localへコピーする。docker --env-file用なので値を引用符で囲まない。
# IPv4構成のため、SupabaseのConnect画面からSession poolerの接続文字列を取得する。
DATABASE_URL=postgresql://postgres.project-ref:URLエンコード済みパスワード@実際のpoolerホスト:5432/postgres?sslmode=require
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=実際のSupabase公開キー
JWT_SECRET=独立した十分に長いランダム値
REFRESH_TOKEN_SECRET=独立した十分に長いランダム値
PASSWORD_RESET_TOKEN_SECRET=独立した十分に長いランダム値
EMAIL_VERIFICATION_TOKEN_SECRET=独立した十分に長いランダム値
RESEND_API_KEY=実際のResendキー
PASSWORD_RESET_FROM_EMAIL=noreply@example.com
PASSWORD_RESET_URL_BASE=https://frontend.example.com/reset-password
EMAIL_VERIFICATION_FROM_EMAIL=noreply@example.com
EMAIL_VERIFICATION_URL_BASE=https://frontend.example.com/verify-email
ALLOWED_ORIGINS=https://frontend.example.com
COOKIE_SAMESITE=Lax
COOKIE_SECURE=true
NODE_ENV=production
PORT=3000
ENABLE_API_DOCS=false
OTEL_TRACES_ENABLED=false
